<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        A fullscreen, title-less theme.

        `windowFullscreen` and `windowContentOverlay` keep the system bars out of
        the layout; `MainActivity.applyImmersiveMode()` additionally hides them
        at runtime, because a manifest-only fullscreen window still reveals the
        bars on a swipe.

        `windowBackground` is black rather than the platform default so the
        surface never flashes white while the emulator initialises.
    -->
    <style name="Theme.Pound" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
    </style>

</resources>