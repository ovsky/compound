/.ninja_log
.ccache/
sccache/

# -----------------------------------------------------------------------------
# Android / Gradle
# -----------------------------------------------------------------------------

# Native images staged into the APK source tree by the Gradle externalNativeBuild
# step. Generated, and large; must never be committed.
android/.gradle/
android/build/
android/local.properties
android/app/build/
android/app/.cxx/
android/app/src/main/jniLibs/

# Generated by `gradle wrapper` if a contributor chooses to add the wrapper.
/android/gradle/wrapper/gradle-wrapper.jar
/android/gradlew
/android/gradlew.bat

